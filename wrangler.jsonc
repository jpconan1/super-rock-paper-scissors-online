{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "super-rps-online",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-12",
  "dev": {
    "ip": "localhost",
    "port": 8787
  },
  "routes": [
    { "pattern": "abm.jpconan.ca", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/health",
      "/maintenance-status",
      "/auth-capabilities",
      "/email-signup/request",
      "/email-signup/verify",
      "/email-login/request",
      "/email-login/verify",
      "/email-password/request",
      "/email-password/update",
      "/account-deletion/request",
      "/account-deletion",
      "/online-status",
      "/analytics/events",
      "/admin/api/*",
      "/admin/auth/google",
      "/account-method",
      "/player-session",
      "/player-progression",
      "/local-match-grant",
      "/local-progress-award",
      "/api/auth/*",
      "/matches",
      "/matches/*",
      "/matchmaking",
      "/lobby",
      "/whiteboard"
    ]
  },
  "durable_objects": {
    "bindings": [
      { "name": "MATCHES", "class_name": "MatchObject" },
      { "name": "MATCHMAKER", "class_name": "MatchmakerObject" },
      { "name": "LOBBY", "class_name": "LobbyObject" },
      { "name": "WHITEBOARD", "class_name": "WhiteboardObject" }
    ]
  },
  "migrations": [{
    "tag": "v1",
    "new_sqlite_classes": ["MatchObject", "MatchmakerObject", "LobbyObject", "WhiteboardObject"]
  }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "super-rps-online",
    "database_id": "78998a29-8eb7-43ae-bced-80a2123c57c9",
    "migrations_dir": "worker/migrations"
  }],
  "vars": {
    "BETTER_AUTH_URL": "https://abm.jpconan.ca"
  },
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "ratelimits": [
    { "name": "SOCKET_RATE", "namespace_id": "731001", "simple": { "limit": 120, "period": 60 } },
    { "name": "MATCHMAKING_IP_RATE", "namespace_id": "731002", "simple": { "limit": 600, "period": 60 } },
    { "name": "MATCHMAKING_GUEST_RATE", "namespace_id": "731003", "simple": { "limit": 120, "period": 60 } },
    { "name": "SIGNUP_REQUEST_RATE", "namespace_id": "731004", "simple": { "limit": 10, "period": 60 } },
    { "name": "SIGNUP_VERIFY_RATE", "namespace_id": "731005", "simple": { "limit": 20, "period": 60 } }
  ]
}
